{
    "name": "ehdl-ide",
    "private": true,
    "version": "0.1.0",
    "description": "EHDL - ECAD using HDL. A VHDL-to-schematic IDE, as a native-embedded web app (Tauri + Vite + React).",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "gen:schematic": "node scripts/generate-schematic.mjs",
        "build": "npm run gen:schematic && tsc && vite build",
        "test:vhdl": "tsc src/vhdlPart.ts scripts/vhdl-part-tests.ts --outDir .tmp-vhdl-tests --module commonjs --target es2020 --lib es2020,dom --skipLibCheck && node scripts/run-vhdl-tests.cjs",
        "preview": "vite preview",
        "tauri": "tauri"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.0.0",
        "flexlayout-react": "^0.10.8",
        "monaco-editor": "^0.56.0",
        "react": "^18.3.0",
        "react-dom": "^18.3.0"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.0.0",
        "@tscircuit/core": "^0.0.1861",
        "@tscircuit/schematic-viewer": "^2.0.89",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.0",
        "circuit-to-svg": "^0.0.410",
        "playwright-core": "^1.63.0",
        "tscircuit": "^0.0.2467",
        "typescript": "^5.5.0",
        "vite": "^5.4.0"
    },
    "overrides": {
        "circuit-json": "0.0.479"
    }
}
