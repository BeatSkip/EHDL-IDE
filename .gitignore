# ---- Node / frontend ----
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# npm cache (redirected into the workspace locally)
.npm-cache/

# compiled output of the VHDL parser tests (npm run test:vhdl)
.tmp-vhdl-tests/

# compiled VHDL helpers used by the schematic generator
.tmp-schematic/

# compiled symbol parser used by the symbol generator
.tmp-symbol/

# Playwright browser downloads (not used at runtime)
.pw-browsers/

# ---- Generated output — never committed ----
# Everything under a `generated` folder is produced from the sources:
#   src/generated/    schematic SVG, netlist, BOM and circuit JSON
#                     (written by `npm run gen:schematic`, run by build and dev)
#   <project>/generated/  the same artifacts for whichever project is open
#                         (written by the schematic pane's Generate button)
#   <library>/symbols/generated/  symbol previews from the symbol generator
# Delete it at any time; the next build or generate recreates it.
generated/

# ---- Tauri / Rust ----
src-tauri/target/
src-tauri/gen/

# ---- Editors / OS ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.user
*.userosscache
*.sln.doc.state

# ---- Environment / secrets ----
.env
.env.*
!.env.example
